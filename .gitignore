# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo
.next/
.turbo/
next-env.d.ts

# Test / coverage
coverage/
*.lcov

# Environment — never commit real values
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# CONTENT POLICY ENFORCEMENT — see docs/CONTENT_POLICY.md
#
# The normal Git repository must never contain real unrevealed production
# questions, accepted production answers, sealed Family Feud board labels, or
# future challenge secrets. These rules are a tooling backstop so that policy
# does not depend on memory alone.
#
# Development fixtures belong in content/test-only/ and ARE committed.
# ---------------------------------------------------------------------------
content/production-sealed/
content/production/
content/sealed/
*.sealed.json
*.production.json

# ---------------------------------------------------------------------------
# Unity Host Display — see docs/UNITY_HOST.md and docs/ARCHITECTURE.md §1
#
# Assets/, Packages/ and ProjectSettings/ are the project and ARE tracked.
# Everything below is generated, machine-specific or a build output.
# ---------------------------------------------------------------------------
unity/host/Library/
unity/host/Temp/
unity/host/Obj/
unity/host/Build/
unity/host/Builds/

# A stray full copy of the repo, created by pointing Unity Hub's "Add project"
# at the wrong folder. Not a submodule and not wanted in history.
unity/host/brains-and-bacchanal/
unity/host/Logs/
unity/host/UserSettings/
unity/host/MemoryCaptures/
unity/host/Recordings/
unity/host/ShaderCache/
unity/host/Artifacts/
unity/host/.vs/
unity/host/.vscode/

# Unity batch-mode logs written at the repo root by the test/build scripts.
unity_*.log
*.csproj
*.unityproj
*.sln
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb.meta
*.apk
*.aab
sysinfo.txt
crashlytics-build.properties

# Ephemeral development token for cloud benchmark testing. Never commit.
.cloud-test-token

# Python bytecode from the tools/ verification harnesses.
__pycache__/
*.pyc
