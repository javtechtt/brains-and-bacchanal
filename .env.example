# ---------------------------------------------------------------------------
# Brains & Bacchanal — example environment
#
# Copy to .env and adjust. Never commit a real .env.
# ARCHITECTURE.md §10 — "keep secrets out of Git".
# ---------------------------------------------------------------------------

# --- Game server ---
GAME_SERVER_PORT=4000
GAME_SERVER_HOST=0.0.0.0

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# development | test | production
NODE_ENV=development

# --- Rooms (Phase 4) ---
# Public base URL of the PLAYER WEB APP. Used to build join links and the QR
# code the Unity Host displays.
#
# Leave EMPTY for a local party: the server detects a LAN address at startup,
# preferring an ordinary 192.168.x / 10.x address over Docker, WSL, Tailscale
# and link-local interfaces. Set it explicitly when the game is reached through
# a tunnel or a real deployment, where the server cannot infer how the outside
# world addresses it.
PUBLIC_BASE_URL=

# Maximum players per room. Default 24 — comfortably three teams of eight.
GAME_SERVER_ROOM_CAPACITY=24

# --- Web app ---
# Base URL the browser uses to reach the game server.
#
# Usually leave EMPTY: the page derives it from its own origin, which is the
# address that demonstrably reached that phone. Set it only when the server is
# on a different host from the web app.
NEXT_PUBLIC_GAME_SERVER_URL=

# --- Content ---
# CONTENT_POLICY.md — development must use TEST content only.
# Valid: test-only | production
CONTENT_SOURCE=test-only
